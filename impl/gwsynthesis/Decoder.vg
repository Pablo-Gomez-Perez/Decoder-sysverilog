wire GND;
  mux_triState mux (
    .tx4_d(tx4_d),
    .tx3_d(tx3_d),
    .led_d(led_d),
    .rx2_Z(rx2_Z)
);
  demux dmx (
    .tx2_d(tx2_d),
    .led_d(led_d),
    .rx4_d(rx4_d)
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* uart_selector */
module top (
