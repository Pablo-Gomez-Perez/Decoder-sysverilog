module gw_gao (
  tms_pad_i,
  tck_pad_i,
  tdi_pad_i,
  clk_d,
  rx3_d,
  rx4_d,
  led_d,
  rx2_Z,
  tx3_d,
  tx4_d,
  tx2_d,
  tdo_pad_o
)
;
input tms_pad_i;
input tck_pad_i;
input tdi_pad_i;
input clk_d;
input rx3_d;
input rx4_d;
input led_d;
input rx2_Z;
input tx3_d;
input tx4_d;
input tx2_d;
