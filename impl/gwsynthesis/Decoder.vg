output rx3_d;
output rx4_d;
output rx2_Z;
wire VCC;
wire GND;
  mux_triState mux (
    .tx3_d(tx3_d),
    .tx4_d(tx4_d),
    .led_d(led_d),
    .rx2_Z(rx2_Z)
);
  demux dmx (
    .led_d(led_d),
    .tx2_d(tx2_d),
    .rx3_d(rx3_d),
    .rx4_d(rx4_d)
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* uart_selector */
